# ===== 必填 =====
# 百炼 API Key（注意要和下面的地域一致）
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx

# 业务空间 ID，在百炼控制台「业务空间详情」里查看
DASHSCOPE_WORKSPACE_ID=xxxxxxxxxxxx

# beijing 或 singapore
DASHSCOPE_REGION=beijing

# ===== 可选 =====
OMNI_MODEL=qwen3.8-omni-flash-realtime
OMNI_VOICE=Tina
OMNI_INSTRUCTIONS=你是个人助理小云，正在通过实时语音和用户聊天。你的回答会被合成为语音播放，所以直接说话，不要说自己只能打字或不能语音。回答简短、自然、口语化，不要用 Markdown、列表或表情符号。
# 静音多久判定说完（毫秒），越小响应越快，但更容易被停顿误触发
OMNI_SILENCE_MS=500
# server_vad / semantic_vad / semantic_vad_ec
OMNI_VAD=server_vad

# 如果不想用 WORKSPACE_ID + REGION，可以直接给完整地址（优先）
# DASHSCOPE_WS_URL=wss://xxxx.cn-beijing.maas.aliyuncs.com/api-ws/v1/realtime

# 服务监听地址。手机/局域网访问改成 0.0.0.0，但麦克风需要 HTTPS
HOST=127.0.0.1
PORT=8000
